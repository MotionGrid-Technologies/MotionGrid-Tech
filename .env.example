# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- MotionGrid Supabase (SITE_*) ------------------------------------
SITE_SUPABASE_URL=https://<project-ref>.supabase.co
SITE_SUPABASE_SERVICE_ROLE_KEY=<server-only service role key>
NEXT_PUBLIC_SITE_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SITE_SUPABASE_ANON_KEY=<public anon key>

# --- Email (Resend) --------------------------------------------------
RESEND_API_KEY=<resend api key>
EMAIL_FROM=hi@updates.motiongrid.co.za
EMAIL_DISPLAY_NAME="Motion Grid"
ADMIN_NOTIFICATION_EMAIL=hello@motiongrid.co.za

# --- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://motiongrid.co.za

# --- Cloudflare Turnstile (login + public forms) ---------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key>
TURNSTILE_SECRET_KEY=<secret key>

# --- Analytics (optional) --------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=<posthog project api key>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GSC_VERIFICATION=<search console verification key>

# --- Welcome email sequence cron (/api/cron/email-sequences) ---------
# Any scheduler may call the route hourly with this bearer token.
CRON_SECRET=<random secret string>

# --- Client-app kill switch (/api/subscription-status) ---------------
# Shared secret. Client apps send it as the x-kill-switch-key header
# (MOTIONGRID_KILL_SWITCH_KEY on their side).
KILL_SWITCH_API_KEY=<random secret string>
